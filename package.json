{
  "name": "triage-desk",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @triagedesk/api --filter @triagedesk/web dev",
    "dev:api": "pnpm --filter @triagedesk/api dev",
    "dev:web": "pnpm --filter @triagedesk/web dev",
    "db:up": "pnpm --filter @triagedesk/api db:up",
    "db:up:detached": "pnpm --filter @triagedesk/api db:up:detached",
    "db:down": "pnpm --filter @triagedesk/api db:down",
    "db:migrate": "pnpm --filter @triagedesk/api db:migrate",
    "db:seed": "pnpm --filter @triagedesk/api db:seed",
    "test": "pnpm --filter @triagedesk/api test",
    "typecheck": "pnpm --filter @triagedesk/api typecheck && pnpm --filter @triagedesk/web exec tsc -b",
    "build": "pnpm typecheck && pnpm --filter @triagedesk/web build"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "onnxruntime-node"
    ]
  }
}
