[Unit]
Description=TriageDesk API
After=network.target postgresql.service

[Service]
Type=simple
User=triage-desk
Group=triage-desk
WorkingDirectory=/opt/triage-desk/apps/api
ExecStart=/usr/bin/pnpm start
Environment=NODE_OPTIONS=--max-old-space-size=384
Restart=on-failure
RestartSec=3
MemoryMax=900M
CacheDirectory=triage-desk
CacheDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
