DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/triage_desk?schema=public"
JWT_SECRET="change-me"
PORT=3001
PUBLIC_ORIGIN="http://127.0.0.1:5173"
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER="deepseek"
# Optional overrides; provider-safe defaults are selected automatically.
# LLM_BASE_URL="https://api.deepseek.com"
# LLM_MODEL="deepseek-v4-flash"

# Local Chinese embedding for hybrid RAG. Set to "disabled" for lexical-only fallback.
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="Xenova/bge-small-zh-v1.5"
# Optional trusted mirror for networks that cannot reach huggingface.co.
# EMBEDDING_REMOTE_HOST="https://hf-mirror.com"
EMBEDDING_CACHE_DIR=".model-cache"
